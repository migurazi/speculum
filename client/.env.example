# Speculum client 환경변수 예시 — .env.local 에 복사 후 실값 주입.
# 이 파일은 git 에 커밋됨 (placeholder 만 포함, 실값 없음).

# ── Backend 연결 ──────────────────────────────────────────────────────────────
# FastAPI uvicorn base URL. dev default: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── NextAuth / Auth.js v5 ─────────────────────────────────────────────────────
# AUTH_SECRET: NextAuth 세션 암호화 + HS256 JWS 서명 shared secret.
# backend FastAPI 와 동일 값을 공유해야 함 (ADR-0021 D1.1 모델 B).
# 생성: openssl rand -base64 32
# 절대 실값을 이 파일에 적지 말 것 — .env.local 또는 배포 secret manager 에 주입.
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# AUTH_URL: Next.js 앱 public URL. 로컬 dev 는 자동 추론(생략 가능).
# 운영 배포 시 명시 필수 (예: https://speculum.example.com)
# AUTH_URL=https://speculum.example.com

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Google Cloud Console → API & Services → Credentials 에서 발급.
# 승인된 리디렉션 URI: {AUTH_URL}/api/auth/callback/google
# 실 credential 확보 시 .env.local 에 주입 — 이 파일에는 placeholder 만.
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
