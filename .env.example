# Speculum 환경변수 template — M0 T0 scaffold.
#
# 본 파일은 **실제 secret 포함 X** — repo 에 commit 안전. 개발자가 본 파일을
# `.env` 로 복사 후 값 채워 사용. `.env` 는 .gitignore 에 등록되어 있음
# (commit 차단).
#
# 사용법:
#   cp .env.example .env
#   # .env 를 편집해 실제 키 값 채우기
#   # server: SPECULUM_DATABASE_URL 등은 export 또는 dotenv 사용
#   # client: client/.env.local 로 복사 (Next.js 자동 로드)

# =============================================================================
# server/ — FastAPI + Alembic + 일배치
# =============================================================================

# 실행 환경 (dev / staging / prod) — middleware 정책 결정 (config.py).
SPECULUM_ENV=dev

# PostgreSQL 연결 — docker-compose.yml 의 postgres service 와 일치.
# 비워두면 Fake repository 모드 (T13 wiring 비활성, 단위 test 와 동일 동작).
SPECULUM_DATABASE_URL=postgresql+psycopg://speculum:speculum@localhost:5432/speculum_dev

# DART OpenAPI key — https://opendart.fss.or.kr 에서 발급.
# 비워두면 integration test (test_dart_real.py) 가 자동 skip + 일배치
# (dart_daily.py) 는 모든 회사 failure 분류.
DART_API_KEY=

# Sentry DSN (선택, M1 backlog) — 일배치 실패 alert (AC-O-02).
# SENTRY_DSN=

# Anthropic LLM — 운영 공시 사실추출 (ADR-0031 D6).
# ANTHROPIC_API_KEY: https://console.anthropic.com 에서 발급. 미설정 시 fact
#   extraction 엔드포인트가 503 (운영 LLM 미연동 = 정상 상태, release blocker 해제 후
#   설정). 테스트는 client= 주입으로 SDK/키 없이 통과(D6 경계).
ANTHROPIC_API_KEY=
# SPECULUM_ENABLE_LLM_FACT_EXTRACTION: 명시 opt-in — ANTHROPIC_API_KEY 와 함께 둘 다
#   설정해야 LLM fact extraction 활성. 미설정(기본) 또는 "0"/"false" 시 키가 있어도
#   503 비활성. 키 단독 설정만으로는 운영 LLM 이 켜지지 않는다 — ADR-0006 자문 완료
#   후 운영 배포 시 "1" 로 설정할 것 (ADR-0031 D6 우발 활성 방지).
SPECULUM_ENABLE_LLM_FACT_EXTRACTION=
# ANTHROPIC_MODEL: 사용할 Claude 모델. 미설정 시 기본값 claude-opus-4-8.
# ANTHROPIC_MODEL=claude-opus-4-8

# =============================================================================
# client/ — Next.js 14 + NextAuth
#
# Next.js 는 client/.env.local 을 자동 로드. 본 template 의 client 섹션을
# 그대로 client/.env.local 로 복사하거나, monorepo dotenv 도구 사용.
# =============================================================================

# Backend FastAPI base URL — 빌드 시점 inline 대체 (NEXT_PUBLIC_* prefix).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# NextAuth (auth.js v5) — JWT 서명 + Google OAuth (T35 합류 시).
# AUTH_SECRET: openssl rand -base64 32 로 생성. 운영은 32 bytes random.
AUTH_SECRET=replace-with-openssl-rand-base64-32
# 운영 deploy host (https). 로컬 dev 는 localhost.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (T35 합류 시 사용). https://console.cloud.google.com 에서 발급.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
